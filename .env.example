# Server Configuration
PORT=3000
HOST=127.0.0.1

# Security
# Extension pairing token for authenticating localhost API requests
API_PAIRING_TOKEN=ai_mcq_assistant_secret_token_change_in_production

# AI Provider Configuration
# Optional development fallback - User configuration via extension UI takes precedence
# GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# SQLite Database
DATABASE_FILE=./data/mcq_assistant.db

